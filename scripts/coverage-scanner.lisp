(progn
  (defun coverage-scanner-whitespace-p (character)
    (find character '(#\Space #\Tab #\Newline #\Return #\Page)))

  (defun coverage-scanner-block-comment-end (source position limit)
    (let ((cursor (+ position 2))
          (depth 1))
      (loop while (< cursor limit)
            do (cond
                 ((and (< (1+ cursor) limit)
                       (char= (char source cursor) #\#)
                       (char= (char source (1+ cursor)) #\|))
                  (incf depth)
                  (incf cursor 2))
                 ((and (< (1+ cursor) limit)
                       (char= (char source cursor) #\|)
                       (char= (char source (1+ cursor)) #\#))
                  (decf depth)
                  (incf cursor 2)
                  (when (zerop depth)
                    (return cursor)))
                 (t (incf cursor)))
            finally (return limit))))

  (defun coverage-scanner-reader-position (source position limit)
    (let ((cursor position)
          (*read-eval* nil))
      (loop
        (when (>= cursor limit)
          (return cursor))
        (cond
          ((coverage-scanner-whitespace-p (char source cursor))
           (incf cursor))
          ((char= (char source cursor) #\;)
           (setf cursor (or (position #\Newline source :start cursor :end limit)
                            limit)))
          ((and (< (1+ cursor) limit)
                (char= (char source cursor) #\#)
                (char= (char source (1+ cursor)) #\|))
           (setf cursor
                 (coverage-scanner-block-comment-end source cursor limit)))
          ((and (< (1+ cursor) limit)
                (char= (char source cursor) #\#)
                (char= (char source (1+ cursor)) #\;))
           (let ((eof (gensym "EOF")))
             (multiple-value-bind (form end)
                 (read-from-string source nil eof
                                   :start (+ cursor 2)
                                   :preserve-whitespace t)
               (declare (ignore form))
               (setf cursor end))))
          (t (return cursor))))))

  (defun coverage-scanner-read-span (source position limit)
    (let* ((*read-eval* nil)
           (start (coverage-scanner-reader-position source position limit))
           (eof (gensym "EOF")))
      (when (>= start limit)
        (return-from coverage-scanner-read-span (values nil start)))
      (handler-case
          (multiple-value-bind (form end)
              (read-from-string source nil eof
                                :start start
                                :preserve-whitespace t)
            (if (or (eq form eof) (<= end start) (> end limit))
                (values nil start)
                (values (list :start start :end end :form form) end)))
        (error () (values nil start)))))

  (defun coverage-scanner-list-elements (source span)
    (let* ((limit (getf span :end))
           (start (coverage-scanner-reader-position
                   source (getf span :start) limit)))
      (unless (and (< start limit)
                   (char= (char source start) #\())
        (return-from coverage-scanner-list-elements nil))
      (let ((position (1+ start))
            (elements nil))
        (loop
          (setf position
                (coverage-scanner-reader-position source position limit))
          (when (>= position limit)
            (return (nreverse elements)))
          (when (char= (char source position) #\))
            (return (nreverse elements)))
          (multiple-value-bind (element end)
              (coverage-scanner-read-span source position limit)
            (unless element
              (return-from coverage-scanner-list-elements nil))
            (push element elements)
            (setf position end))))))

  (defun coverage-scanner-form-operator (form)
    (when (and (consp form) (symbolp (first form)))
      (string-upcase (symbol-name (first form)))))

  (defun coverage-scanner-literal-datum-p (form)
    (let ((seen (make-hash-table :test #'eq)))
      (labels ((literal-p (value)
                          (cond
                           ((or (numberp value) (stringp value) (characterp value)
                                (symbolp value))
                            t)
                           ((or (consp value) (vectorp value))
                            (unless (gethash value seen)
                              (setf (gethash value seen) t)
                              (if (consp value)
                                  (and (literal-p (car value))
                                       (literal-p (cdr value)))
                                (loop for element across value
                                      always (literal-p element)))))
                           (t nil))))
        (literal-p form))))

  (defun coverage-scanner-literal-constant-p (form)
    (or (numberp form)
        (stringp form)
        (characterp form)
        (eq form t)
        (null form)
        (and (symbolp form)
             (eq (symbol-package form) (find-package :keyword)))
        (and (consp form)
             (eq (first form) 'quote)
             (= (length form) 2)
             (coverage-scanner-literal-datum-p (second form)))))

  (defun coverage-scanner-key-marker-p (form)
    (and (symbolp form)
         (plusp (length (symbol-name form)))
         (char= (char (symbol-name form) 0) #\&)))

  (defun coverage-scanner-defun-key-bindings (source owner)
    (let* ((owner-elements (coverage-scanner-list-elements source owner))
           (lambda-list (third owner-elements))
           (key-seen nil)
           (bindings nil))
      (when lambda-list
        (dolist (parameter (coverage-scanner-list-elements source lambda-list))
          (let ((form (getf parameter :form)))
            (cond
              ((and (symbolp form)
                    (string-equal (symbol-name form) "&KEY"))
               (setf key-seen t))
              ((and key-seen (coverage-scanner-key-marker-p form))
               (setf key-seen nil))
              ((and key-seen (consp form))
               (push parameter bindings))))))
      (nreverse bindings)))

  (defun coverage-scanner-key-binding-shape-p (form)
    (and (consp form)
         (member (length form) '(2 3))
         (let ((parameter (first form)))
           (and (or (symbolp parameter)
                    (and (consp parameter)
                         (= (length parameter) 2)
                         (keywordp (first parameter))
                         (symbolp (second parameter))))
                (or (= (length form) 2)
                    (symbolp (third form)))))))

  (defun coverage-scanner-defun-default-spans (source owner)
    (let ((spans nil))
      (dolist (binding (coverage-scanner-defun-key-bindings source owner))
        (let* ((form (getf binding :form))
               (parts (coverage-scanner-list-elements source binding)))
          (when (and (coverage-scanner-key-binding-shape-p form)
                     (coverage-scanner-literal-constant-p (second form))
                     (second parts))
            (push (cons (getf (second parts) :start)
                        (getf (second parts) :end))
                  spans))))
      spans))

  (defun coverage-scanner-defstruct-default-spans (source owner)
    (labels ((slot-options-p (options)
                             (cond
                              ((null options) t)
                              ((null (cdr options)) nil)
                              (t
                               (let ((option (getf (first options) :form))
                                     (value (getf (second options) :form)))
                                 (and (or (and (eq option :type)
                                               (or (symbolp value)
                                                   (and (consp value)
                                                        (coverage-scanner-literal-datum-p value))))
                                          (and (eq option :read-only)
                                               (member value '(nil t))))
                                      (slot-options-p (cddr options))))))))
      (let* ((elements (coverage-scanner-list-elements source owner))
             (slots (cddr elements))
             (spans nil))
        (when (and slots (stringp (getf (first slots) :form)))
          (setf slots (rest slots)))
        (dolist (slot slots)
          (let* ((form (getf slot :form))
                 (parts (coverage-scanner-list-elements source slot)))
            (when (and (consp form)
                       (symbolp (first form))
                       (>= (length form) 2)
                       (coverage-scanner-literal-constant-p (second form))
                       (second parts)
                       (slot-options-p (cddr parts)))
              (push (cons (getf (second parts) :start)
                          (getf (second parts) :end))
                    spans))))
        spans)))

  (defun coverage-owner-exclusion-allowed-p (owner source uncovered-forms)
    (let* ((form (getf owner :form))
           (operator (coverage-scanner-form-operator form))
           (spans (cond
                    ((and operator (string= operator "DEFUN"))
                     (coverage-scanner-defun-default-spans source owner))
                    ((and operator (string= operator "DEFSTRUCT"))
                     (coverage-scanner-defstruct-default-spans source owner))))
           (uncovered-forms (copy-list uncovered-forms)))
      (and spans
           uncovered-forms
           (every (lambda (uncovered)
                    (and (eq (getf uncovered :kind) :expression)
                         (member (cons (getf uncovered :start)
                                       (getf uncovered :end))
                                 spans :test #'equal)))
                  uncovered-forms)))))
