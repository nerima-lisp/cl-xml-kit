(in-package #:cl-xml-kit/test)

(describe "element content"
  (it "emits a complete pull event sequence"
    (expect (mapcar #'xml-event-type (pull-events "<root>hi<x/></root>"))
            :to-equal '(:start-document :start-element :characters
                        :start-element :end-element :end-element
                        :end-document)))

  (it "parses markup generated by an internal general entity"
    (let ((item (first (xml-element-children
                        (document-element
                         "<!DOCTYPE doc [<!ENTITY item \"<item>ok</item>\">]><doc>&item;</doc>")))))
      (expect (xml-name-local-name (xml-element-name item)) :to-equal "item")
      (expect (xml-text-data (first (xml-element-children item))) :to-equal "ok")))

  (it-each (("<r></s>"
             (xml-well-formedness-error (xml-well-formedness-error-constraint :element-type-match)
                                        (xml-well-formedness-error-expected "r")
                                        (condition-offset 5)))
            ("<root><child></root>"
             (xml-well-formedness-error (xml-well-formedness-error-constraint :element-type-match)
                                        (xml-well-formedness-error-expected "child")
                                        (condition-offset 15)))
            ("<r>"
             (xml-well-formedness-error (xml-well-formedness-error-constraint :well-formedness)
                                        (xml-well-formedness-error-expected :end-tag)
                                        (condition-offset 3)))
            ("<!DOCTYPE r [<!ENTITY e '<a>'>]><r>&e;</r>"
             (xml-well-formedness-error (xml-well-formedness-error-constraint :well-formedness)
                                        (xml-well-formedness-error-expected :end-tag)
                                        (condition-offset 3)))
            ("<!DOCTYPE doc [<!ENTITY item \"</item>\">]><doc>&item;</doc>"
             (xml-well-formedness-error (xml-well-formedness-error-constraint :element-type-match)
                                        (xml-well-formedness-error-expected :start-tag)
                                        (condition-offset 2)))
            ("<r><!DOCTYPE r></r>"
             (xml-well-formedness-error (xml-well-formedness-error-constraint :content)
                                        (xml-well-formedness-error-expected nil)
                                        (condition-offset 3)))
            ("<r><?xml version='1.0'?></r>"
             (xml-well-formedness-error (xml-well-formedness-error-constraint :processing-instruction)
                                        (xml-well-formedness-error-expected :non-xml-target)
                                        (condition-offset 3)))
            ("<r><?XmL x?></r>"
             (xml-well-formedness-error (xml-well-formedness-error-constraint :processing-instruction)
                                        (xml-well-formedness-error-expected :non-xml-target)
                                        (condition-offset 3)))
            ("<r><?a:b d?></r>"
             (xml-input-error (xml-condition-message "TARGET must not contain a colon.")))
            ("<root>&unknown;</root>"
             (xml-well-formedness-error (xml-well-formedness-error-constraint :entity-declared)
                                        (xml-well-formedness-error-expected "unknown")
                                        (condition-offset nil)))
            ("<root><!--bad--comment--></root>"
             (xml-well-formedness-error (xml-well-formedness-error-constraint :comment)
                                        (xml-condition-message "XML comments must not contain '--'.")
                                        (condition-offset 13))))
      "rejects the element content of ~S" (input expected)
    (expect (lambda () (parse-xml input)) :to-signal-xml expected)))

(describe "attributes"
  (it "accepts less-than written as a reference in an attribute value"
    (expect (mapcar #'xml-attribute-value
                    (xml-element-attributes
                     (document-element "<a b=\"&lt;\" c='&#60;' d=\"x&#x3C;y\"/>")))
            :to-equal '("<" "<" "x<y")))

  (it "keeps attributes in source order"
    (expect (mapcar (lambda (attribute) (xml-name-local-name (xml-attribute-name attribute)))
                    (xml-element-attributes (document-element "<r z='1' a='2' m='3'/>")))
            :to-equal '("z" "a" "m")))

  (it-each (("<r a=\"1\" a=\"2\"/>"
             (xml-well-formedness-error (xml-well-formedness-error-constraint :unique-att-spec)
                                        (xml-well-formedness-error-expected "a unique attribute name")
                                        (condition-offset 1)))
            ("<p xmlns:a=\"urn:x\" xmlns:b=\"urn:x\" a:id=\"1\" b:id=\"2\"/>"
             (xml-well-formedness-error
              (xml-well-formedness-error-constraint :unique-att-spec)
              (xml-well-formedness-error-expected "a unique expanded attribute name")
              (condition-offset 1)))
            ("<root a=\"unterminated></root>"
             (xml-well-formedness-error (xml-well-formedness-error-constraint :attribute-value)
                                        (xml-well-formedness-error-expected nil)
                                        (condition-offset 22)))
            ("<!DOCTYPE a [<!ENTITY e '&#60;'>]><a b=\"&e;\"/>"
             (xml-well-formedness-error
              (xml-well-formedness-error-constraint :no-lt-in-attribute-values)
              (xml-well-formedness-error-expected "a character other than <")
              (condition-offset 0)))
            ("<root><p:item/></root>"
             (xml-namespace-error (xml-namespace-error-prefix "p") (condition-offset 7))))
      "rejects the attributes or name of ~S" (input expected)
    (expect (lambda () (parse-xml input)) :to-signal-xml expected)))

(describe "references"
  (it "decodes decimal and hexadecimal character references in content and attributes"
    (let ((root (document-element "<a b=\"&#65;&#x42;&#xaF;\">&#x41;&#66;&#xAf;</a>")))
      (expect (xml-attribute-value (first (xml-element-attributes root)))
              :to-equal (format nil "AB~C" (code-char #xAF)))
      (expect (xml-text-data (first (xml-element-children root)))
              :to-equal (format nil "AB~C" (code-char #xAF)))))

  ;; U+0666 and U+0665 are Arabic-Indic digits: DIGIT-CHAR-P accepts them, XML does not.
  (it-each (("<a>&#1z;</a>" "Malformed numeric character reference." 7)
            ("<a b=\"&#1z;\"/>" "Malformed numeric character reference." 10)
            ("<a>&#x4G;</a>" "Malformed numeric character reference." 8)
            ("<a>&#x;</a>" "Malformed numeric character reference." 6)
            ("<a b='&#x;'/>" "Malformed numeric character reference." 9)
            ("<a>&#٦٥;</a>" "Malformed numeric character reference." 7)
            ("<a b=\"&#٦٥;\"/>" "Malformed numeric character reference." 10)
            ("<!DOCTYPE a [<!ENTITY e '&#٦٥;'>]><a/>" "Malformed XML character reference." 0)
            ("<!DOCTYPE a [<!ENTITY e '&#1z;'>]><a/>" "Malformed XML character reference." 0))
      "rejects the malformed character reference in ~S" (input message offset)
    (expect (lambda () (parse-xml input))
            :to-signal-xml `(xml-well-formedness-error
                             (xml-well-formedness-error-constraint :character-reference)
                             (xml-condition-message ,message)
                             (condition-offset ,offset))))

  (it "emits one skipped-entity event where a skipped external entity is referenced"
    (let* ((input (concatenate 'string +skip-doctype+ "<r>a&x;b</r>"))
           (events (pull-events input :external-entity-policy :skip))
           (skipped (find :skipped-external-entity events :key #'xml-event-type)))
      (expect (mapcar #'event-summary events)
              :to-equal '((:start-document nil nil) (:doctype nil nil)
                          (:start-element "r" nil) (:characters nil "a")
                          (:skipped-external-entity "x" nil) (:characters nil "b")
                          (:end-element "r" nil) (:end-document nil nil)))
      (expect (xml-event-external-p skipped) :to-be-truthy)
      (expect (xml-position-offset (xml-event-position skipped)) :to-equal 64)))

  (it "emits one skipped-entity event for a skipped entity in replacement text"
    (let* ((input (concatenate 'string +skip-doctype+ "<r>&i;</r>"))
           (events (pull-events input :external-entity-policy :skip))
           (position (xml-event-position
                      (find :skipped-external-entity events :key #'xml-event-type))))
      (expect (mapcar #'event-summary events)
              :to-equal '((:start-document nil nil) (:doctype nil nil)
                          (:start-element "r" nil) (:characters nil "[]")
                          (:skipped-external-entity "x" nil)
                          (:end-element "r" nil) (:end-document nil nil)))
      (expect (list (xml-position-offset position) (xml-position-line position)
                    (xml-position-column position))
              :to-equal '(1 1 2))
      (expect (text-content (document-element input :external-entity-policy :skip))
              :to-equal "[]")))
  (it "emits skipped-entity events at their places in nested replacement text"
    (let* ((input (concatenate 'string
                               "<!DOCTYPE r [<!ENTITY x SYSTEM \"urn:x\">"
                               "<!ENTITY j \"<q>&x;</q>\"><!ENTITY k \"a&j;&#10;&x;b\">]>"
                               "<r>&k;</r>"))
           (events (pull-events input :external-entity-policy :skip)))
      (expect (mapcar #'event-summary events)
              :to-equal `((:start-document nil nil) (:doctype nil nil)
                           (:start-element "r" nil) (:characters nil "a")
                           (:start-element "q" nil) (:skipped-external-entity "x" nil)
                           (:end-element "q" nil) (:characters nil ,(format nil "~%b"))
                           (:skipped-external-entity "x" nil)
                           (:end-element "r" nil) (:end-document nil nil)))
      (expect (mapcar (lambda (event)
                        (let ((position (xml-event-position event)))
                          (list (xml-position-offset position) (xml-position-line position)
                                (xml-position-column position))))
                      (remove-if-not (lambda (event)
                                       (eq (xml-event-type event) :skipped-external-entity))
                                     events))
              :to-equal '((4 1 5) (9 2 1))))))

(describe "resource limits"
  (it-each (("<a><b/></a>" (:max-depth 2))
            ("<a x='1'/>" (:max-attributes-per-element 1))
            ("<a><b/></a>" (:max-elements 2))
            ("<a>ab&amp;c</a>" (:max-text-node-length 4)))
      "accepts ~S at the limit ~S" (input limit)
    (expect (xml-name-local-name
             (xml-element-name
              (document-element input :resource-limits
                                (apply #'make-xml-resource-limits limit))))
            :to-equal "a"))

  (it-each (("<a><b><c/></b></a>" (:max-depth 2) :max-depth 3 2)
            ("<a x=\"1\" y=\"2\"/>" (:max-attributes-per-element 1)
             :max-attributes-per-element 2 1)
            ("<a><b/><c/></a>" (:max-elements 2) :max-elements 3 2)
            ("<a>ab&amp;cd</a>" (:max-text-node-length 4) :max-text-node-length 5 4))
      "rejects ~S beyond the limit ~S" (input limit kind value maximum)
    (expect (lambda ()
              (parse-xml input :resource-limits (apply #'make-xml-resource-limits limit)))
            :to-signal-xml `(xml-resource-limit-exceeded
                             (xml-resource-limit-exceeded-kind ,kind)
                             (xml-resource-limit-exceeded-value ,value)
                             (xml-resource-limit-exceeded-limit ,maximum))))

  (it "counts the text-node limit per character run, so a comment starts a new run"
    (let ((limits (make-xml-resource-limits :max-text-node-length 3)))
      (expect (mapcar #'xml-text-data
                      (remove-if-not #'xml-text-p
                                     (xml-element-children
                                      (document-element "<a>ab&amp;<!---->cd&amp;</a>"
                                                        :resource-limits limits))))
              :to-equal '("ab&" "cd&")))))
