(in-package #:cl-xml-kit/test)

(defun parser-events (input &rest keys)
  (let ((parser (apply #'make-xml-parser input keys))
        (events nil))
    (loop for event = (next-xml-event parser)
          while event do (push event events))
    (nreverse events)))

(it "emits a complete pull event sequence"
  (let ((types (mapcar #'xml-event-type (parser-events "<root>hi<x/></root>"))))
    (expect types :to-equal '(:start-document :start-element :characters
                              :start-element :end-element :end-element
                              :end-document))))

(it "normalizes attributes, expands entities, and coalesces text"
  (let* ((document (parse-xml "<!DOCTYPE root [<!ENTITY hi \"there\">]><root a=\"x&amp;y\">one&hi;two</root>"))
         (root (second (xml-document-children document))))
    (expect (xml-attribute-value (first (xml-element-attributes root)))
            :to-equal "x&y")
    (expect (length (xml-element-children root)) :to-equal 1)
    (expect (xml-text-data (first (xml-element-children root)))
            :to-equal "onetheretwo")))

(it "parses markup generated by an internal general entity"
  (let* ((document (parse-xml
                    "<!DOCTYPE doc [<!ENTITY item \"<item>ok</item>\">]><doc>&item;</doc>"))
         (root (second (xml-document-children document)))
         (item (first (xml-element-children root))))
    (expect (xml-name-local-name (xml-element-name item)) :to-equal "item")
    (expect (xml-text-data (first (xml-element-children item))) :to-equal "ok")))

(it "rejects malformed markup generated by an internal general entity"
  (expect (handler-case
              (progn
                (parse-xml
                 "<!DOCTYPE doc [<!ENTITY item \"</item>\">]><doc>&item;</doc>")
                nil)
            (xml-well-formedness-error () t))
          :to-equal t))

(it "rejects duplicate attributes and mismatched tags"
  (expect (handler-case (progn (parse-xml "<r a=\"1\" a=\"2\"/>") nil)
            (xml-well-formedness-error () t)) :to-equal t)
  (expect (handler-case (progn (parse-xml "<r></s>") nil)
            (xml-well-formedness-error () t)) :to-equal t))

(it "rejects text outside the single root"
  (expect (handler-case (progn (parse-xml "text<r/>") nil)
            (xml-well-formedness-error () t)) :to-equal t)
  (expect (handler-case (progn (parse-xml "<r/>text") nil)
            (xml-well-formedness-error () t)) :to-equal t))

(it "keeps a parser fatal after malformed input"
  (let ((parser (make-xml-parser "<r>")))
    (handler-case (loop while (next-xml-event parser))
      (xml-kit-error () nil))
    (expect (handler-case (progn (next-xml-event parser) nil)
              (xml-parser-state-error () t)) :to-equal t)))

